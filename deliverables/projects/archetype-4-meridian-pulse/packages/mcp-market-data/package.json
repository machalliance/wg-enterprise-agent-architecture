{
  "name": "@meridian-pulse/mcp-market-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing read-only market perception (competitor prices, demand signals, inventory) with an embedded scenario driver.",
  "main": "dist/index.js",
  "bin": {
    "mcp-market-data": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.13.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
