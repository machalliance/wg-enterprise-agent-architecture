# ---------------------------------------------------------------------------
# Meridian Pulse — environment template
#
#   cp .env.example .env     then uncomment only the lines you need
#
# This is the committed template: it lists EVERY variable the code reads, with
# its default, and every line is commented out on purpose. A freshly copied .env
# changes nothing — the demo runs on the built-in defaults. Uncomment a line only
# to override its default. (scripts/env-docs.test.mjs enforces both properties:
# the template stays copy-safe, and it documents every process.env the code reads.)
#
# The agent and MCP servers never read provider credentials directly; everything
# flows through AgentGateway (infra/agentgateway/config.yaml).
# ---------------------------------------------------------------------------


# ── LLM provider (behind AgentGateway) ──────────────────────────────────────
# DEFAULT: a generic OpenAI-compatible endpoint. Point LLM_BASE_URL at any
# OpenAI-compatible URL (OpenAI, a local Ollama/LM Studio, or a shim). Read by
# the gateway's default `llm` block in infra/agentgateway/config.yaml.
#LLM_BASE_URL=http://localhost:11434/v1
#LLM_MODEL=gpt-4o-mini
#LLM_API_KEY=changeme

# ── ALTERNATIVE: Amazon Bedrock ─────────────────────────────────────────────
# To route to Claude on Bedrock instead, switch the `llm` block in
# infra/agentgateway/config.yaml to the commented Bedrock variant (provider:
# bedrock, model: us.anthropic.claude-sonnet-5, awsRegion). Credentials resolve
# from the standard AWS chain (env, profile, SSO, role).
#AWS_REGION=us-east-1
#AWS_PROFILE=meridian-pulse
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# ── AgentGateway ports ──────────────────────────────────────────────────────
# Fixed in infra/agentgateway/config.yaml (NOT env-driven); noted here for
# reference only: LLM :4000, MCP :3000, admin :15000, Prometheus metrics :15020.

# ── MCP servers ─────────────────────────────────────────────────────────────
# Seed directory the servers load catalog/competitors/mandate/timeline from.
# Unset = the committed ./seed. Point it at an alternate seed (e.g. seed-demo,
# a quiet baseline for recording a clean demo) to change the starting market
# without touching the real seed. Identity stays at the fixed ./seed/identity.
#SEED_DIR=seed
# Commerce catalog SQLite path (mcp-commerce is the system of record).
#MCP_COMMERCE_DB=packages/mcp-commerce/catalog.db
# Multiplier on each scenario event's scheduled time: 1 = real time, <1 = faster
# (compress the timeline for a quick demo), >1 = slower. (Timed mode only.)
#SCENARIO_TICK_SCALE=1
# 1 loops the scenario timeline forever (demo/dev); 0 runs it once. (Timed mode only.)
#SCENARIO_LOOP=0
# Scenario driver mode: "timed" (default) fires events on a clock; "manual" fires
# nothing until the presenter advances one demo BEAT at a time — see HOW-TO-DEMO.md.
#SCENARIO_MODE=timed
# Manual mode only: trigger file whose integer contents = beats requested. The
# market-data driver polls it; `pnpm scenario:step` increments it. A file (not a
# port) so it survives the gateway spawning the MCP child more than once.
#SCENARIO_TRIGGER_FILE=packages/mcp-market-data/scenario-step.trigger

# ── Control plane (kill switch, breakers, heartbeat, dashboard) ─────────────
#CONTROL_PLANE_PORT=8090
# Where the policy server reaches the control plane's breaker endpoint.
#CONTROL_PLANE_URL=http://localhost:8090
# Dead-man's-switch: auto-halt if no agent heartbeat within this many ms.
#HEARTBEAT_TIMEOUT_MS=60000

# ── Agent loop ──────────────────────────────────────────────────────────────
# Seconds between perceive -> reason -> act cycles.
#AGENT_CYCLE_INTERVAL_S=8
# Stop after N cycles (0 = run forever). The demo runner sets this for bounded runs.
#AGENT_MAX_CYCLES=0
# Goose session name the loop resumes each cycle.
#AGENT_SESSION_NAME=meridian-pulse

# ── Durable state & accountability (M2 / M4) ────────────────────────────────
# Agent checkpoint store (SQLite). Working + long-term memory, hash-chained.
#AGENT_CHECKPOINT_DB=packages/agent/checkpoint.db
# How many checkpoints to retain (older ones pruned; the chain stays verifiable).
#CHECKPOINT_RETENTION=50
# Append-only, hash-chained decision trail (M4).
#DECISION_TRAIL_PATH=packages/policy/decision-trail.jsonl
# Escalation queue (M3) — pending/approved/rejected price changes.
#ESCALATION_QUEUE_PATH=packages/policy/escalation-queue.jsonl
# Tier-2 NOTIFY log — changes executed with a notification to merchandising.
#NOTIFY_LOG_PATH=packages/policy/notifications.jsonl

# ── Goose -> AgentGateway wiring ────────────────────────────────────────────
# Goose points at AgentGateway's OpenAI-compatible LLM endpoint (never a provider
# directly). The real provider credential lives in the gateway, so OPENAI_API_KEY
# can be any non-empty value. The demo runner (scripts/demo.sh) sets these; listed
# here so a hand-run of `goose run` can reproduce them.
#GOOSE_PROVIDER=openai
#GOOSE_MODEL=default
#OPENAI_HOST=http://localhost:4000
#OPENAI_BASE_PATH=v1/chat/completions
#OPENAI_API_KEY=gateway-holds-the-real-credential

# ── Agent machine identity (M1) ─────────────────────────────────────────────
# The agent presents a scoped JWT to the gateway on every MCP call. Keys + token
# are generated locally into seed/identity/ (priv.pem + agent-credential.json are
# gitignored; jwks.json is public and committed). Regenerate with:
#   node packages/agent/dist/identity.js keygen   # once
#   node packages/agent/dist/identity.js mint      # refresh the token
#AGENT_JWT_ISSUER=meridian-pulse
#AGENT_JWT_AUDIENCE=meridian-pulse-gateway
#AGENT_JWT_TTL_S=3600
