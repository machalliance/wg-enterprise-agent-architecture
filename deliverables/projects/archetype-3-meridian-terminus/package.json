{
  "name": "meridian-terminus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference prototype for Archetype 3: a goal-directed, task-oriented payment repair agent that finishes.",
  "license": "MIT",
  "_engines_note": "eve itself requires Node >=24. The offline replay and the test suite use only node:test and native type stripping, so they run on 22.6+ — which is why the version here is the framework's floor, not the prototype's.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "replay": "node --experimental-strip-types infra/replay.ts",
    "replay:commit": "REPAIR_MODE=commit node --experimental-strip-types infra/replay.ts",
    "replay:starved": "REPAIR_MODE=commit MAX_STEPS=4 node --experimental-strip-types infra/replay.ts",
    "verify:trail": "node --experimental-strip-types infra/verify-trail.ts",
    "dev": "next dev",
    "build": "next build",
    "deploy": "eve deploy",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start": "next start",
    "start:eve": "eve start",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.48",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@shikijs/core": "3.23.0",
    "@shikijs/engine-javascript": "3.23.0",
    "@shikijs/engine-oniguruma": "3.23.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "ai": "7.0.78",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eve": "0.44.3",
    "just-bash": "3.4.2",
    "lucide-react": "1.16.0",
    "motion": "12.40.0",
    "nanoid": "5.1.11",
    "next": "16.3.0-preview.6",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "3.23.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "use-stick-to-bottom": "1.1.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  }
}
