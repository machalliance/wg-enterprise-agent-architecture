# ── AI Provider ──────────────────────────────────────────────────────────────
# Pick one provider and supply the matching API key.
# AI_PROVIDER can also be set in your config JSON; the env var takes precedence.

ANTHROPIC_API_KEY=sk-ant-...          # default provider
# OPENAI_API_KEY=sk-...              # set AI_PROVIDER=openai to use this
# AI_GATEWAY_API_KEY=vck_...         # set AI_PROVIDER=vercel to use this

AI_PROVIDER=anthropic                 # options: anthropic | openai | vercel

# Model to use. Defaults shown below per provider.
# Vercel AI Gateway model names are prefixed with the upstream provider.
# AI_MODEL=claude-sonnet-4-6         # Anthropic default
# AI_MODEL=gpt-4o                    # OpenAI default
# AI_MODEL=anthropic/claude-sonnet-4-6  # Vercel AI Gateway default


# ── Outputs ───────────────────────────────────────────────────────────────────
# Configure at least one output: Slack, GitHub Issues, or Research Mode.

# Slack — post the daily digest to a channel via an Incoming Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# GitHub Issues — save each digest as a GitHub Issue
SAVE_AS_GITHUB_ISSUE=false           # set true to enable
GITHUB_TOKEN=ghp_...                 # required when SAVE_AS_GITHUB_ISSUE=true
GITHUB_REPOSITORY=owner/repo         # required when SAVE_AS_GITHUB_ISSUE=true

# Research Mode — extract and accumulate claims against a hypothesis over time
RESEARCH_MODE=false                  # set true to enable


# ── Runtime Overrides ─────────────────────────────────────────────────────────
# These override the values in your config JSON.

CONFIG_PATH=config/example.json      # path to your watcher config (relative to repo root)
LOOKBACK_HOURS=24                    # how far back to scan for articles
