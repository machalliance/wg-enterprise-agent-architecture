# The AGNTCY dir JS SDK (agntcy-dir) depends on generated protobuf types published to the buf.build
# npm registry under the @buf scope. This maps that scope to buf.build so `pnpm install` resolves it.
@buf:registry=https://buf.build/gen/npm/v1/

# The 7-day publish quarantine that used to sit here lives in pnpm-workspace.yaml as `minimumReleaseAge:
# 10080`. It is NOT an .npmrc setting: pnpm reads it from the workspace manifest only, so `min-release-age
# = 7` here was inert config that read as an active supply-chain control. See pnpm-workspace.yaml for the
# policy (and the two exact-version exemptions that go with it).
