# Copy to .env. Every variable this project reads is listed here.
# .env is gitignored; this file is committed and must stay in sync.

# --- Model routing -----------------------------------------------------------
# AI Gateway credential. eve uses it for any string model id ("anthropic/...").
# On a Vercel deployment VERCEL_OIDC_TOKEN is present instead and eve prefers it;
# `eve link` pulls it into .env.local for local dev, where it lasts 12 hours.
# Not needed for `npm test` or `npm run replay` — neither calls a model.
# AI_GATEWAY_API_KEY=vck_xxx

# --- Run mode ----------------------------------------------------------------
# dry-run (default): repairs are computed, re-validated against a projection and
# traced, but never committed to the batch. This is how the desk earns its write
# scope — you watch a full run without it first.
# commit: repairs are written to the working copy.
REPAIR_MODE=dry-run

# --- Budget override ---------------------------------------------------------
# Overrides seed/mandate.json's step ceiling. Set it low (4) to watch the
# BUDGET_EXHAUSTED branch, which is otherwise never exercised on a batch this
# small. Used by the replay harness only.
# MAX_STEPS=4

# --- eve --------------------------------------------------------------------
# Port for `eve dev` (default 2000).
# PORT=2000
# Capture model and tool I/O in eve's local traces. Off by default because the
# trail already records what this desk needs and the local traces would then
# hold a second, unchained copy of the same payment data.
# EVE_TRACES_CONTENT=on

# --- Direct model routing (alternative to AI Gateway) ------------------------
# Set LLM_BASE_URL to route the agent at any OpenAI-compatible endpoint instead
# of AI Gateway. Unset means the gateway.
# LLM_BASE_URL=https://example.com/api/v1

# Model id in the endpoint's own namespace, read only when LLM_BASE_URL is set.
# LLM_MODEL=openai/gpt-5.4

# Credential for that endpoint. Read only when LLM_BASE_URL is set.
# LLM_API_KEY=

# --- Trail persistence -------------------------------------------------------
# off: the trail and the outcome record are held in memory and never written to
# trails/. The test suite sets this so its fixture trails do not land in a
# directory a reviewer cannot tell apart from real runs. Unset, or any other
# value, writes them.
# TERMINUS_TRAIL=off
